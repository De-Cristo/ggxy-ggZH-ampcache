# NLO gridpack on one 16-core node (reference: 4 h 16 min).  Add your site's container,
# runtime and accounting settings.  LO companion: arguments = gridpack ggxy_ggZH_ZToLL_LO_13p6TeV <name>
executable              = run_cms_job.sh
arguments               = gridpack ggxy_ggZH_ZToLL_13p6TeV ggxy_ggZH_ZToLL_13p6TeV 16 3
transfer_input_files    = cms.tgz
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = ggxy_ggZH_el8_amd64_gcc10_CMSSW_12_4_11_ggxy_ggZH_ZToLL_13p6TeV.tgz, out-gridpack.tgz
request_cpus            = 16
request_memory          = 24 GB
request_disk            = 40 GB
output                  = logs/gridpack.out
error                   = logs/gridpack.err
log                     = logs/gridpack.log
queue
