# Validation sample: 200 jobs x 1000 NLO events with the nine scale weights (reference:
# about 0.5 core-hour per job).  For the LO sample: arguments = nanogen 2000 $INT(seed) scale lo, queue 100.
executable              = run_cms_job.sh
seed                    = $(Process) + 1
arguments               = nanogen 1000 $INT(seed) scale nlo
transfer_input_files    = cms.tgz, ggxy_ggZH_el8_amd64_gcc10_CMSSW_12_4_11_ggxy_ggZH_ZToLL_13p6TeV.tgz
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = out-nanogen-$INT(seed).tgz
request_cpus            = 1
request_memory          = 4 GB
request_disk            = 10 GB
output                  = logs/nanogen-$(Process).out
error                   = logs/nanogen-$(Process).err
log                     = logs/nanogen.log
queue 200
