# ggxy fixed order.  Reference statistics: LO 2 jobs x 4 seeds (2001-2008, 2e6 points),
# NLO 10 jobs x 4 seeds (3001-3040, 1e6 points); stable Z (fo-ggzh) 1 job x 2 seeds per PDF.
# About 1000 s per LO seed and 5000 s per NLO seed.
executable              = run_job.sh
transfer_input_files    = generator.tgz, ggzh-install.tgz
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
request_cpus            = 4
request_memory          = 8 GB
request_disk            = 5 GB
environment             = "NCPU=4"
log                     = logs/fo.log

first                   = 2001 + 4 * $(Process)
arguments               = fo lo $INT(first) 4
transfer_output_files   = out-fo-lo-$INT(first).tgz
output                  = logs/fo-lo-$(Process).out
error                   = logs/fo-lo-$(Process).err
queue 2

first                   = 3001 + 4 * $(Process)
arguments               = fo nlo $INT(first) 4
transfer_output_files   = out-fo-nlo-$INT(first).tgz
output                  = logs/fo-nlo-$(Process).out
error                   = logs/fo-nlo-$(Process).err
queue 10
