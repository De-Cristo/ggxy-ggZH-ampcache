+!  extra%only_ggzh = .true.: the LO ZH matrix element (qqb_zh) returns only the loop-induced
+!  gg -> ZH term (gg_zh).  For an LO cross-check of gg -> ZH (part = lo); added for
+!  ggxy-ggZH-ampcache/generator/mcfm.
+module ggzh_only
+  implicit none
+  logical, public, save :: only_ggzh = .false.
+end module ggzh_only
