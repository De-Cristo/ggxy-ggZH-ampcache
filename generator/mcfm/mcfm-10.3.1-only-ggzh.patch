       include 'types.f'
 c***********************************************************************
@@ -28,6 +29,9 @@
       real(dp):: p(mxpart,4)
       real(dp):: s,prop,fac,q1423,q2413,s56,v2(2)
       real(dp):: msq(-nf:nf,-nf:nf),hdecay,msqhgamgam
+      complex(dp):: za(mxpart,mxpart),zb(mxpart,mxpart)
+      real(dp):: brwen,brzee,brznn,brtau,brtop,brcharm
+      logical, save:: firstgg=.true.
 
       s(j,k)=2*(p(j,4)*p(k,4)-p(j,1)*p(k,1)-p(j,2)*p(k,2)-p(j,3)*p(k,3))
 
@@ -36,6 +40,21 @@
 
       msq(:,:)=0._dp
 
+c--- only_ggzh: loop-induced gg -> ZH only (LO cross-check of gg -> ZH).
+c--- gg_zh reads s(5,6) for the Higgs decay from sprods_com, so fill it
+c--- for all six particles first.  BR(Z->ee) is printed so that a run
+c--- with removebr can be converted back to Z -> e+ e- in the m34 window.
+      if (only_ggzh) then
+        if (firstgg) then
+          firstgg=.false.
+          call branch(brwen,brzee,brznn,brtau,brtop,brcharm)
+          write(6,*) 'only_ggzh: brzee = ',brzee
+        endif
+        call spinoru(6,p,za,zb)
+        call gg_zh(p,msq(0,0))
+        return
+      endif
+
 c---calculate the 2 Z propagators
       prop=     ((s(1,2)-zmass**2)**2+(zmass*zwidth)**2)
       prop=prop*((s(3,4)-zmass**2)**2+(zmass*zwidth)**2)
